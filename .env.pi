# ─────────────────────────────────────────────────────────
# APOCALYPSE TERMINAL — Raspberry Pi 4 Configuration
# Copy this file to .env on your Pi:
#   cp .env.pi .env
# Then restart the server:
#   python -m backend.app.main
# ─────────────────────────────────────────────────────────

# Enable physical GPIO hardware (buttons + 7-seg + buzzer)
USE_HARDWARE=true

# Bind to all interfaces so browser on LAN can connect
HOST=0.0.0.0
PORT=8000

# Leave blank to keep Gemini disabled (100% offline)
GEMINI_API_KEY=

# GPIO pins (BCM numbering) — change only if wiring differs
PIN_BTN_RED=5
PIN_BTN_BLUE=6
PIN_BTN_GREEN=13
PIN_BTN_YELLOW=19
PIN_BTN_CONFIRM=16

PIN_SEGMENT_A=2
PIN_SEGMENT_B=3
PIN_SEGMENT_C=4
PIN_SEGMENT_D=18
PIN_SEGMENT_E=22
PIN_SEGMENT_F=23
PIN_SEGMENT_G=24

PIN_BUZZER=12
