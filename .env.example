# Apocalypse Terminal Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000

# Hardware Mode: "auto" (default), "true", or "false".
# In "auto" mode, hardware GPIO is automatically enabled if running on a Raspberry Pi.
# Set to "false" to force software emulation for Mac/PC/laptop development.
USE_HARDWARE=auto

# GPIO Pin Configuration (BCM pin numbers)
# Arcade Buttons (Pull-Up active low)
PIN_BTN_RED=5
PIN_BTN_BLUE=6
PIN_BTN_GREEN=13
PIN_BTN_YELLOW=19
PIN_BTN_CONFIRM=16

# Single-digit 7-Segment Display (Cathode or Anode with matching GPIO pins A through G)
PIN_SEGMENT_A=2
PIN_SEGMENT_B=3
PIN_SEGMENT_C=4
PIN_SEGMENT_D=18
PIN_SEGMENT_E=22
PIN_SEGMENT_F=23
PIN_SEGMENT_G=24

# Passive Buzzer (PWM)
PIN_BUZZER=12

# Optional Gemini API (Game is 100% playable offline without this)
# Used exclusively for emergent atmospheric radio chatter and journal flavor
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
